---
import type { ClientRecord } from '../../lib/clients';
import { addressLineFor } from '../../lib/clients';

interface Props {
  client: ClientRecord;
}

const { client } = Astro.props;
const address = addressLineFor(client);
---

<footer class="border-t border-border-subtle bg-bg-surface-alt py-12">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-3">
      <div>
        <p class="font-display text-2xl text-text-primary">{client.company}</p>
        {address && <p class="mt-3 font-body text-sm text-text-secondary">{address}</p>}
        {client.phone && <p class="mt-1 font-body text-sm text-text-secondary">{client.phone}</p>}
        {client.email && <p class="mt-1 font-body text-sm text-text-secondary">{client.email}</p>}
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-text-muted mb-4">Leistungen</p>
        <ul class="space-y-2">
          {['Inspektion & Wartung', 'HU/AU-Vorbereitung', 'Bremsenservice', 'Reifenwechsel', 'Klimaservice', 'Diagnose'].map(item => (
            <li class="font-body text-sm text-text-secondary">{item}</li>
          ))}
        </ul>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-text-muted mb-4">Kontakt</p>
        <div class="space-y-3">
          {client.phone && (
            <a href={`tel:${client.phone.replace(/\s+/g, '')}`} class="flex items-center gap-2 font-body text-sm text-text-secondary hover:text-accent transition-colors">
              <svg class="h-4 w-4 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
              {client.phone}
            </a>
          )}
          {client.email && (
            <a href={`mailto:${client.email}`} class="flex items-center gap-2 font-body text-sm text-text-secondary hover:text-accent transition-colors">
              <svg class="h-4 w-4 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
              {client.email}
            </a>
          )}
          <a href="#angebot" class="flex items-center gap-2 font-body text-sm text-accent hover:text-accent-hover transition-colors">
            <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Termin anfragen
          </a>
        </div>
      </div>
    </div>
    <div class="mt-10 flex flex-col items-center gap-3 border-t border-border-subtle pt-8 text-center sm:flex-row sm:justify-between">
      <p class="font-body text-xs text-text-muted">
        © {new Date().getFullYear()} {client.company} — Website-Vorschau von GudeCode.de
      </p>
      <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-text-muted">
        Unverbindliche Vorschau · Beispielinhalte
      </p>
    </div>
  </div>
</footer>
