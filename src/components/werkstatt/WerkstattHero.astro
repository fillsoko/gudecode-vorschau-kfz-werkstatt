---
import { Image } from 'astro:assets';
import FadeIn from '../motion/FadeIn';
import heroImage from '../../assets/images/werkstatt/hero.webp';
import { heroTextFor, type ClientRecord } from '../../lib/clients';

interface Props {
  client: ClientRecord;
}

const { client } = Astro.props;
---

<section id="hero" class="relative min-h-screen flex items-end overflow-hidden">
  <div class="absolute inset-0" aria-hidden="true">
    <Image src={heroImage} alt="" class="w-full h-full object-cover" widths={[1200, 1920]} sizes="100vw" quality={90} loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-t from-bg-primary via-bg-primary/70 to-bg-primary/20"></div>
  </div>
  <div class="relative z-10 w-full max-w-5xl mx-auto px-6 pb-24 md:pb-28 text-center">
    <FadeIn client:load delay={0.1} direction="up" eager>
      <p class="font-mono text-xs uppercase tracking-[0.35em] text-accent mb-5">Exklusive Vorschau für {client.company}</p>
      <h1 class="font-display text-5xl sm:text-6xl md:text-7xl leading-tight text-text-primary">{client.company}</h1>
      {client.city && <p class="mt-3 font-body text-sm tracking-[0.2em] uppercase text-text-muted">KFZ-Werkstatt in {client.city}</p>}
      <p class="font-body text-text-secondary text-base md:text-lg max-w-2xl mx-auto mt-6 mb-10 leading-relaxed">{heroTextFor(client)}</p>
    </FadeIn>
    <FadeIn client:load delay={0.3} direction="up" eager>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#angebot" class="inline-block min-w-[240px] rounded-full bg-accent px-8 py-3 text-sm font-body font-medium tracking-widest text-bg-primary hover:bg-accent-hover transition-colors text-center">Termin vereinbaren</a>
        <a href="#leistungen" class="inline-block min-w-[240px] rounded-full border border-border px-8 py-3 text-sm font-body font-medium tracking-widest text-text-primary hover:bg-bg-surface transition-colors text-center">Leistungen ansehen</a>
      </div>
    </FadeIn>
  </div>

  <!-- Trust badges row -->
  <div class="relative z-10 border-t border-border-subtle bg-bg-surface/70 backdrop-blur-sm">
    <div class="max-w-6xl mx-auto px-6 py-4 flex flex-wrap items-center justify-center gap-x-10 gap-y-2">
      {[
        { icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z', text: 'Meisterbetrieb & Garantie' },
        { icon: 'M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z', text: 'Termin in 48 Std.' },
        { icon: 'M4.5 12.75l6 6 9-13.5', text: 'Kostenvoranschlag vorab' },
        { icon: 'M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12', text: 'Hol- & Bringservice' },
      ].map(item => (
        <span class="flex items-center gap-2 font-body text-xs text-text-muted">
          <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg>
          {item.text}
        </span>
      ))}
    </div>
  </div>
</section>
