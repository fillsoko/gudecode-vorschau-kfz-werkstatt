<section id="leistungen" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
  <div class="reveal text-center">
    <p class="font-mono text-xs uppercase tracking-[0.35em] text-accent">Beispiel-Leistungen</p>
    <h2 class="mt-4 text-4xl md:text-5xl text-text-primary">Alles aus einer Hand</h2>
    <p class="mx-auto mt-4 max-w-2xl font-body text-text-secondary">
      Von der Inspektion bis zur Diagnose — alle Inhalte sind Beispiele dieser
      Vorschau und werden durch Ihr echtes Leistungsangebot ersetzt.
    </p>
  </div>
  <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {services.map((service, i) => (
      <div class={`reveal reveal-delay-${(i % 3) + 1} group rounded-2xl border border-border-subtle bg-bg-surface p-8 hover:border-accent/40 transition-colors duration-300`}>
        <div class="flex items-start justify-between gap-4">
          <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent-muted text-accent" aria-hidden="true">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={service.icon} /></svg>
          </span>
          <span class="mt-1 rounded-full border border-border-subtle px-2.5 py-0.5 font-mono text-[0.6rem] uppercase tracking-[0.2em] text-text-muted">{service.tag}</span>
        </div>
        <h3 class="mt-5 text-xl text-text-primary group-hover:text-accent transition-colors duration-200">{service.title}</h3>
        <p class="mt-3 font-body text-sm leading-relaxed text-text-secondary">{service.text}</p>
      </div>
    ))}
  </div>
</section>
