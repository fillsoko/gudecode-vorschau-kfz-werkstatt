---

<section id="fahrzeuge" class="bg-bg-surface-alt py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal text-center">
      <p class="font-mono text-xs uppercase tracking-[0.35em] text-accent">Fahrzeugtypen</p>
      <h2 class="mt-4 text-4xl md:text-5xl text-text-primary">Für welches Fahrzeug?</h2>
      <p class="mx-auto mt-4 max-w-2xl font-body text-text-secondary">
        Diese Werkstatt nimmt ein breites Spektrum an — die folgende Übersicht
        ist ein Beispielinhalt der Vorschau.
      </p>
    </div>
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {vehicles.map((vehicle, i) => (
        <div class={`reveal reveal-delay-${i + 1} rounded-2xl border border-border-subtle bg-bg-surface p-6 text-center`}>
          <svg class="mx-auto h-9 w-9 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d={vehicle.icon} />
          </svg>
          <h3 class="mt-4 text-lg text-text-primary">{vehicle.title}</h3>
          <p class="mt-2 font-body text-sm leading-relaxed text-text-secondary">{vehicle.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
